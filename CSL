<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bitácora de Solicitudes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --steel: #2B3A42;
    --steel-dark: #1D2830;
    --paper: #F6F4EF;
    --paper-line: #E4DFD3;
    --ink: #23282B;
    --ink-soft: #6B7480;
    --orange: #E8622C;
    --orange-dark: #C94F1F;
    --ok-green: #2F7D5A;
    --err-red: #C0392B;
    --radius: 6px;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;
    padding:0;
    background:var(--steel-dark);
    background-image:
      radial-gradient(circle at 10% 10%, rgba(255,255,255,0.03), transparent 40%),
      radial-gradient(circle at 90% 90%, rgba(255,255,255,0.03), transparent 40%);
    font-family:'IBM Plex Sans', -apple-system, sans-serif;
    color:var(--ink);
    min-height:100vh;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:40px 16px;
  }
  .ticket{
    width:100%;
    max-width:560px;
    background:var(--paper);
    border-radius:var(--radius);
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.5);
    overflow:hidden;
  }
  /* --- Stub / encabezado tipo ticket --- */
  .stub{
    background:var(--steel);
    color:#fff;
    padding:22px 26px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
  }
  .stub-title{
    display:flex;
    flex-direction:column;
    gap:4px;
  }
  .eyebrow{
    font-size:11px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:#B8C4CC;
    font-weight:600;
  }
  .stub-title h1{
    margin:0;
    font-size:20px;
    font-weight:700;
    letter-spacing:-0.01em;
  }
  .folio-box{
    text-align:right;
    font-family:'IBM Plex Mono', monospace;
    flex-shrink:0;
  }
  .folio-label{
    font-size:10px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:#B8C4CC;
  }
  .folio-number{
    font-size:19px;
    font-weight:600;
    color:var(--orange);
    transition:color 0.2s;
  }
  .folio-number.pending{color:#8b98a1; font-weight:400; font-style:italic; font-size:14px;}

  /* --- Perforación --- */
  .perf{
    position:relative;
    height:0;
    border-top:2px dashed var(--paper-line);
    margin:0 26px;
  }
  .perf::before, .perf::after{
    content:"";
    position:absolute;
    top:-11px;
    width:22px;
    height:22px;
    background:var(--steel-dark);
    border-radius:50%;
  }
  .perf::before{ left:-37px; }
  .perf::after{ right:-37px; }

  /* --- Cuerpo del formulario --- */
  form{
    padding:28px 26px 26px;
    display:flex;
    flex-direction:column;
    gap:18px;
  }
  .field{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .field label{
    font-size:12px;
    font-weight:600;
    letter-spacing:0.03em;
    color:var(--ink-soft);
    text-transform:uppercase;
  }
  .field label .req{ color:var(--orange); margin-left:2px; }
  .field .hint{
    font-size:12px;
    color:var(--ink-soft);
    margin-top:-2px;
  }

  select, input[type=text], input[type=date], textarea{
    font-family:'IBM Plex Sans', sans-serif;
    font-size:14.5px;
    color:var(--ink);
    background:#fff;
    border:1px solid #D8D2C4;
    border-radius:var(--radius);
    padding:10px 12px;
    width:100%;
    transition:border-color 0.15s, box-shadow 0.15s;
  }
  select:focus, input:focus, textarea:focus{
    outline:none;
    border-color:var(--orange);
    box-shadow:0 0 0 3px rgba(232,98,44,0.15);
  }
  textarea{ resize:vertical; min-height:88px; line-height:1.5; }

  input[readonly]{
    background:#EFEBE2;
    color:var(--ink-soft);
    font-family:'IBM Plex Mono', monospace;
    font-size:14px;
    cursor:not-allowed;
  }

  select{ appearance:none; -webkit-appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236B7480' stroke-width='2.5'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat:no-repeat;
    background-position:right 12px center;
    padding-right:36px;
  }

  .row-two{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
  }
  @media (max-width:480px){
    .row-two{ grid-template-columns:1fr; }
    .perf::before{ left:-11px; }
    .perf::after{ right:-11px; }
  }

  button.submit{
    margin-top:6px;
    background:var(--orange);
    color:#fff;
    border:none;
    border-radius:var(--radius);
    padding:13px 18px;
    font-size:14.5px;
    font-weight:600;
    letter-spacing:0.01em;
    cursor:pointer;
    transition:background 0.15s, transform 0.05s;
  }
  button.submit:hover{ background:var(--orange-dark); }
  button.submit:active{ transform:scale(0.99); }
  button.submit:disabled{ background:#C9BBB0; cursor:not-allowed; }

  .status{
    display:none;
    border-radius:var(--radius);
    padding:12px 14px;
    font-size:13.5px;
    line-height:1.5;
  }
  .status.show{ display:block; }
  .status.ok{ background:#E7F3EC; color:var(--ok-green); border:1px solid #BFE0CC; }
  .status.err{ background:#FBEAE7; color:var(--err-red); border:1px solid #F0C6BE; }
  .status strong{ font-family:'IBM Plex Mono', monospace; }

  .foot-note{
    text-align:center;
    font-size:11px;
    color:#7C8790;
    padding:14px 26px 22px;
  }
</style>
</head>
<body>

<div class="ticket">
  <div class="stub">
    <div class="stub-title">
      <span class="eyebrow">Registro de solicitudes</span>
      <h1>Bitácora</h1>
    </div>
    <div class="folio-box">
      <div class="folio-label">Folio</div>
      <div class="folio-number pending" id="folioDisplay">se asigna al enviar</div>
    </div>
  </div>

  <div class="perf"></div>

  <form id="bitacoraForm">

    <div class="field">
      <label for="ruta">Planta / Ruta <span class="req">*</span></label>
      <select id="ruta" name="ruta" required>
        <option value="" disabled selected>Selecciona una planta…</option>
        <option>HOLCIM</option>
        <option>CAMIONES</option>
        <option>EXTENSION</option>
        <option>MOTORES NORTE</option>
        <option>METALSA</option>
        <option>VAN</option>
        <option>SABRITAS SALTILLO</option>
        <option>DEACERO PLANTA SALTILLO</option>
        <option>MIXING</option>
        <option>ISRINGHAUSEN</option>
        <option>BORGWARNER RAMOS</option>
        <option>BOCAR</option>
        <option>MOTORES SUR</option>
        <option>DRAXTON SALTILLO</option>
        <option>OMNISOURCE</option>
        <option>CINSA</option>
        <option>SANTA ANITA</option>
        <option>ALPHABET</option>
        <option>HI-LEX</option>
        <option>MONTE BLANCO</option>
        <option>FEHRER LIP SAL</option>
      </select>
    </div>

    <div class="field">
      <label for="tipoSolicitud">Tipo de solicitud <span class="req">*</span></label>
      <input type="text" id="tipoSolicitud" name="tipoSolicitud" placeholder="Ej. Mantenimiento, Unidad extra, Cambio de ruta…" required>
    </div>

    <div class="field">
      <label for="descripcion">Descripción de la solicitud <span class="req">*</span></label>
      <textarea id="descripcion" name="descripcion" placeholder="Describe el detalle de la solicitud…" required></textarea>
    </div>

    <div class="row-two">
      <div class="field">
        <label for="fechaSolicitud">Fecha de solicitud</label>
        <input type="text" id="fechaSolicitud" readonly>
        <span class="hint">Se registra automáticamente</span>
      </div>
      <div class="field">
        <label for="fechaCompromiso">Fecha compromiso <span class="req">*</span></label>
        <input type="date" id="fechaCompromiso" name="fechaCompromiso" required>
      </div>
    </div>

    <div id="statusBox" class="status"></div>

    <button type="submit" class="submit" id="submitBtn">Registrar solicitud</button>
  </form>

  <div class="foot-note">Los registros se guardan directamente en la hoja "Bitacora" de Google Sheets.</div>
</div>

<script>
  // ⚠️ IMPORTANTE: reemplaza esta URL por la que te da Google Apps Script
  // al implementar el proyecto como "Aplicación web" (termina en /exec)
  const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxGPP3SE4sxX2ZKleWMduid9Y9ismn519Trpvg1aLoGOMG2WprJO-UwAOqqYqIwsueB/exec";

  const form = document.getElementById('bitacoraForm');
  const fechaSolicitudInput = document.getElementById('fechaSolicitud');
  const statusBox = document.getElementById('statusBox');
  const submitBtn = document.getElementById('submitBtn');
  const folioDisplay = document.getElementById('folioDisplay');

  function hoyFormateado(){
    const d = new Date();
    const dd = String(d.getDate()).padStart(2,'0');
    const mm = String(d.getMonth()+1).padStart(2,'0');
    const yyyy = d.getFullYear();
    const hh = String(d.getHours()).padStart(2,'0');
    const mi = String(d.getMinutes()).padStart(2,'0');
    return `${dd}/${mm}/${yyyy} ${hh}:${mi}`;
  }
  fechaSolicitudInput.value = hoyFormateado();

  function showStatus(kind, html){
    statusBox.className = 'status show ' + kind;
    statusBox.innerHTML = html;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (APPS_SCRIPT_URL.includes("PEGA_AQUI")) {
      showStatus('err', 'Falta configurar la URL de Apps Script en el código (APPS_SCRIPT_URL).');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Registrando…';
    statusBox.className = 'status';

    const payload = {
      ruta: document.getElementById('ruta').value,
      tipoSolicitud: document.getElementById('tipoSolicitud').value,
      descripcion: document.getElementById('descripcion').value,
      fechaCompromiso: document.getElementById('fechaCompromiso').value
    };

    try {
      const res = await fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.result === 'success') {
        folioDisplay.textContent = data.folio;
        folioDisplay.classList.remove('pending');
        showStatus('ok', `Solicitud registrada con el folio <strong>${data.folio}</strong>.`);
        form.reset();
        fechaSolicitudInput.value = hoyFormateado();
      } else {
        showStatus('err', 'No se pudo registrar: ' + (data.message || 'error desconocido.'));
      }
    } catch (err) {
      showStatus('err', 'Error de conexión al intentar registrar la solicitud.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Registrar solicitud';
    }
  });
</script>

</body>
</html>
